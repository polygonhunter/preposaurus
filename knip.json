{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/server/db/migrate.ts!", "src/server/db/schema/*.ts!", "db/seeds/index.ts!"],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "!src/features/*/domain/**!",
    "!src/shared/lib/{dates,quantities,slug,stock-unit}.ts!",
    "db/**/*.ts!",
    "!db/seeds/{demo*,factories}.ts!",
    "tests/**/*.{ts,tsx}",
    "eslint/**/*.mjs",
    "scripts/**/*.ts"
  ],
  "ignore": ["tests/lint/fixtures/**"]
}
