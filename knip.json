{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server/db/migrate.ts!",
    "src/server/db/schema/*.ts!",
    "db/seeds/index.ts!",
    "src/server/storage/sharp-photo-processor.ts!",
    "src/server/ai/anthropic-adapter.ts!",
    "src/server/notify/nodemailer-mail-sender.ts!",
    "src/features/ai-settings/application/*.ts!",
    "src/features/capture/actions/*.ts!",
    "src/server/auth/guards.ts!",
    "scripts/admin.ts!",
    "tests/e2e/*.setup.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "!src/features/*/domain/**!",
    "!src/shared/lib/{dates,quantities,slug,stock-unit}.ts!",
    "!src/server/{ai,crypto,notify,storage}/**!",
    "!src/features/ai-settings/{application,data}/**!",
    "!src/features/capture/{application/{clean-up-captures,estimate-on-request,find-open-draft}.ts,data/capture-cleanup-repository.ts,schemas/{ai-answers,draft}.ts}!",
    "!src/features/inventory/schemas.ts!",
    "db/**/*.ts!",
    "!db/seeds/{demo*,factories}.ts!",
    "tests/**/*.{ts,tsx}",
    "eslint/**/*.mjs",
    "scripts/*.ts",
    "scripts/admin/*.test.ts",
    "scripts/admin/*.ts!"
  ],
  "ignore": ["tests/lint/fixtures/**"]
}
