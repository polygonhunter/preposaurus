{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server/db/migrate.ts!",
    "src/server/db/schema/*.ts!",
    "db/seeds/index.ts!",
    "scripts/admin.ts!",
    "src/worker/main.ts!",
    "src/shared/sw/service-worker.ts!",
    "tests/e2e/*.setup.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    // Einzelausnahmen im --production-Lauf (#113): Statistik wartet auf #71, Mengenprüfung auf #295
    "!src/features/supply/domain/stats.ts!",
    "!src/features/capture/domain/quantity-plausibility.ts!",
    "db/**/*.ts!",
    "!db/seeds/{demo*,factories}.ts!",
    "tests/**/*.{ts,tsx}",
    "eslint/**/*.mjs",
    "scripts/*.ts",
    "scripts/poc-recognition/*.ts",
    "scripts/admin/*.test.ts",
    "scripts/admin/*.ts!"
  ],
  "ignore": ["tests/lint/fixtures/**"]
}
