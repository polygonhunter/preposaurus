{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server/db/migrate.ts!",
    "src/server/db/schema/*.ts!",
    "db/seeds/index.ts!",
    "scripts/admin.ts!",
    "src/worker/main.ts!",
    "src/shared/sw/service-worker.ts!",
    "tests/e2e/*.setup.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "!src/features/*/domain/**!",
    "!src/shared/lib/{dates,slug,stock-unit}.ts!",
    "db/**/*.ts!",
    "!db/seeds/{demo*,factories}.ts!",
    "tests/**/*.{ts,tsx}",
    "eslint/**/*.mjs",
    "scripts/*.ts",
    "scripts/admin/*.test.ts",
    "scripts/admin/*.ts!"
  ],
  "ignore": ["tests/lint/fixtures/**"]
}
