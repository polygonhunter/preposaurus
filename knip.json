{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/server/db/migrate.ts!",
    "src/server/db/schema/*.ts!",
    "db/seeds/index.ts!",
    "src/server/storage/sharp-photo-processor.ts!",
    "src/server/ai/anthropic-adapter.ts!",
    "src/features/ai-settings/application/*.ts!",
    "src/features/auth/actions/*.ts!",
    "src/features/capture/actions/*.ts!",
    "src/server/auth/guards.ts!",
    "scripts/admin.ts!"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}!",
    "!src/features/*/domain/**!",
    "!src/shared/lib/{dates,quantities,slug,stock-unit}.ts!",
    "!src/server/{ai,crypto,storage}/**!",
    "!src/features/ai-settings/{application,data}/**!",
    "!src/features/capture/{application/{recognize-best-before,estimate-on-request}.ts,schemas.ts}!",
    "!src/features/inventory/{application/**,data/**,schemas.ts}!",
    "!src/features/supply/application/**!",
    "db/**/*.ts!",
    "!db/seeds/{demo*,factories}.ts!",
    "tests/**/*.{ts,tsx}",
    "eslint/**/*.mjs",
    "scripts/*.ts",
    "scripts/admin/*.test.ts",
    "scripts/admin/*.ts!"
  ],
  "ignore": ["tests/lint/fixtures/**"]
}
