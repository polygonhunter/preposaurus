# Vorlage für die Datei .env neben compose.yaml (Betrieb auf dem NAS, docs/INSTALLATION.md).
# Kopieren nach .env und die Platzhalter ersetzen. Die .env enthält Geheimnisse:
# nie ins Repository, nie in einen Chat, getrennt von den Backups sichern.

# Welche Compose-Dateien gelten. Empfohlen ist der Tailscale-Sidecar (beide Dateien).
# Wer Tailscale als Paket direkt auf dem NAS nutzt, setzt nur: COMPOSE_FILE=compose.yaml
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml

# Pflicht. Version des Images, immer eine feste Nummer (kein "latest").
# Die aktuelle Version steht unter https://github.com/polygonhunter/preposaurus/releases
PREPOSAURUS_VERSION=0.1.0

# Pflicht. Passwort der Datenbank-Rolle preposaurus_app (App, migrate, worker). Nur Buchstaben und
# Ziffern, weil es in einer Adresse steht. Nach dem ersten Start nicht mehr ändern.
# Erzeugen mit:  openssl rand -hex 24
POSTGRES_PASSWORD=hier-das-erzeugte-datenbank-passwort

# Pflicht. Passwort der Datenbank-Rolle preposaurus_backup (Backup-Dienst), ein eigener Wert.
# Erzeugen mit:  openssl rand -hex 24
POSTGRES_BACKUP_PASSWORD=hier-das-erzeugte-backup-passwort

# Pflicht. Geheimnis für die Sitzungen, mindestens 32 Zeichen.
# Erzeugen mit:  openssl rand -base64 32
# Ein neuer Wert meldet alle Geräte ab. Getrennt von der Datenbank sichern.
APP_SECRET=hier-das-erzeugte-geheimnis-mit-mindestens-32-zeichen

# Nutzer- und Gruppen-ID, der die Ordner fotos und backups gehören (Linux: "id -u" und "id -g").
# Standard 1000:1000.
PREPOSAURUS_UID=1000
PREPOSAURUS_GID=1000

# Nur mit compose.tailscale.yaml: Gerätename im Tailnet. Er steht im öffentlichen
# Zertifikats-Log, deshalb neutral wählen (nicht "notvorrat" oder den eigenen Namen).
TS_HOSTNAME=haushalt

# Nur mit compose.tailscale.yaml und nur für die erste Anmeldung: Auth-Schlüssel aus dem
# Tailscale-Admin-Bereich (Settings → Keys). Danach kann die Zeile wieder leer sein.
TS_AUTHKEY=

# Uhrzeit der täglichen Sicherung (24-Stunden-Format) und Zeitzone.
BACKUP_TIME=03:00
TZ=Europe/Berlin

# Detailgrad der Logs: debug, info, warn oder error.
LOG_LEVEL=info

# Foto-Erkennung. Den Anthropic-Schlüssel trägt der Admin normalerweise in der App ein
# (verschlüsselt mit APP_SECRET, #108). Steht er hier, hat er Vorrang vor der App.
# Die Foto-Erkennung ist nie Pflicht, ohne Schlüssel geht alles von Hand.
ANTHROPIC_API_KEY=

# Optional: Mails (Wochenübersicht ohne Push, Check-in-Mail) über einen eigenen Mailserver.
# Ohne SMTP_HOST sind Mails aus, alles andere läuft weiter. Mails gehen nur an Nutzer mit
# eingetragener E-Mail-Adresse. Port 587 nutzt STARTTLS, 465 TLS von Anfang an.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
# Anmeldung am Mailserver: beide setzen oder beide leer lassen.
SMTP_USER=
SMTP_PASSWORD=
# Pflicht, sobald SMTP_HOST gesetzt ist. Absender, z. B. Preposaurus <vorrat@example.org>
SMTP_FROM=

# Optional: Adresse der App für den Link in Mails, z. B. https://haushalt.dein-tailnet.ts.net.
# Ohne sie haben Mails keinen Link.
APP_URL=
