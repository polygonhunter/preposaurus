{
  "name": "preposaurus",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/start-standalone.ts",
    "build:cli": "node scripts/build-cli.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint . --max-warnings=0",
    "lint:budget": "eslint src --rule \"max-lines: [warn, {max: 200, skipBlankLines: true, skipComments: true}]\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:perf": "PERF=1 vitest run --no-file-parallelism perf.test",
    "knip": "knip && knip --production",
    "e2e": "playwright test",
    "licenses": "node scripts/check-licenses.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --conditions=react-server src/server/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=react-server db/seeds/index.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env --conditions=react-server db/seeds/demo-cli.ts",
    "check": "npm run format:check && npm run lint && npm run lint:budget && npm run typecheck && npm run knip && npm run test",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@electric-sql/pglite": "0.5.17",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
