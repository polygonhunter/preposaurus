# Vorlage für die Umgebungsvariablen. Kopieren nach .env und Werte eintragen.
# Die .env kommt nie ins Repository. Geprüft wird alles in src/shared/config/env.ts.

# Laufzeitumgebung: development, test oder production (Standard: development, setzt Next selbst)
NODE_ENV=development

# Detailgrad der Logs: debug, info, warn oder error (Standard: info)
LOG_LEVEL=info

# Pflicht. Datenbank: pglite://<ordner> für lokal ohne Installation,
# postgres://<nutzer>:<passwort>@<host>:5432/<db> für PostgreSQL (NAS, CI)
DATABASE_URL=pglite://./.data/dev

# KI-Anbieter: fake (Standard, für Entwicklung und Tests) oder anthropic
AI_PROVIDER=fake

# Nur nötig bei AI_PROVIDER=anthropic. Den Schlüssel nie committen.
ANTHROPIC_API_KEY=

# Modell je Foto-Rolle (Standard: claude-sonnet-5-5)
AI_MODEL_PACKAGING=claude-sonnet-5-5
AI_MODEL_NUTRITION=claude-sonnet-5-5
AI_MODEL_BEST_BEFORE=claude-sonnet-5-5
