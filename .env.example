# Vorlage für die Umgebungsvariablen. Kopieren nach .env und Werte eintragen.
# Die .env kommt nie ins Repository. Geprüft wird alles in src/shared/config/env.ts.

# Laufzeitumgebung: development, test oder production (Standard: development, setzt Next selbst)
NODE_ENV=development

# Detailgrad der Logs: debug, info, warn oder error (Standard: info)
LOG_LEVEL=info

# Pflicht. Datenbank: pglite://<ordner> für lokal ohne Installation,
# postgres://<nutzer>:<passwort>@<host>:5432/<db> für PostgreSQL (NAS, CI)
DATABASE_URL=pglite://./.data/dev

# Pflicht. Geheimnis für die Sitzungs-Cookies und für die Verschlüsselung der KI-Schlüssel in der
# Datenbank, mindestens 32 Zeichen. Erzeugen mit:
#   openssl rand -base64 32
# Getrennt von der Datenbank sichern. Ein neuer Wert meldet alle Geräte ab, und die in der App
# gespeicherten KI-Schlüssel lassen sich nicht mehr lesen (dann neu eintragen).
APP_SECRET=

# Header, aus dem die App die Adresse des Geräts liest (Anmeldebremse je Adresse).
# Tailscale Serve setzt x-forwarded-for und ersetzt dabei einen Wert vom Gerät.
# Nur einen Header eintragen, den der eigene Proxy setzt. Standard: x-forwarded-for
# Den App-Port 3000 nie ins LAN freigeben (nur Tailscale-Sidecar oder 127.0.0.1:3000:3000),
# sonst kann ein Gerät den Header fälschen (EINSTELLUNGEN_NUTZER §4.5).
CLIENT_IP_HEADER=x-forwarded-for

# KI-Anbieter: fake (Standard, für Entwicklung und Tests) oder anthropic
AI_PROVIDER=fake

# Optional. Anthropic-Schlüssel als feste Verbindung „aus Umgebungsvariable“ (z. B. als Docker-Secret).
# Ist er gesetzt, nutzen alle Foto-Rollen diese Verbindung, und die Verbindungen in der App treten
# zurück. Ohne ihn trägt der Admin Schlüssel in der App ein (verschlüsselt mit APP_SECRET).
# Den Schlüssel nie committen.
ANTHROPIC_API_KEY=

# Modelle je Foto-Rolle stehen nicht hier, sondern in den Einstellungen der App.
# Ohne Zuweisung gilt die Empfehlung aus src/shared/config/ai-roles.ts
# (claude-haiku-5-5, beim MHD-Zweitversuch claude-sonnet-5-5).

# Basisordner für Fotos (im Container das Foto-Volume). Alle Fotopfade liegen relativ dazu.
# Standard: ./.data/fotos
PHOTO_STORAGE_DIR=./.data/fotos
